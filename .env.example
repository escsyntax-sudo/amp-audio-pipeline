NODE_ENV=development
PORT=8080
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=dev-insecure-secret
JWT_EXPIRES_IN=12h
STORAGE_DIR=./data/uploads
MAX_UPLOAD_BYTES=209715200
MAX_CHUNK_BYTES=8388608
QUEUE_NAME=amp-transcribe
EVENTS_CHANNEL=amp:events
CORS_ORIGIN=
LOG_LEVEL=info

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WORKER_CONCURRENCY=1
AMP_STORAGE_ROOT=./data/uploads
AMP_OUTPUT_DIR=./data/results
TTS_ENABLED=false
